<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Wisej Cloud fills this value from the site's WISEJ_LICENSE_KEY secret at container startup.
         A nonempty application-provided value is preserved. Injection finishes before the server starts.
         Keep real license keys out of source control. -->
    <add key="Wisej.LicenseKey" value="" />
  </appSettings>
</configuration>
